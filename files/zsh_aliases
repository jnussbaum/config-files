# ~/.zsh_aliases

aliasupdate(){
  source ~/.zshrc
}

###########
# DSP-TOOLS
###########

export TOOLS_HOME="${HOME}/Desktop/Cloned_GitHub_repos/dsp-tools"

alias dtlog="tail -n 15 -f ~/.dsp-tools/logging.log | bat --style=plain --paging=never -l log"

cdtls(){
  cd "${TOOLS_HOME}" 
}

dt(){
    "${TOOLS_HOME}/.venv/bin/dsp-tools" "$@"
}

dtup(){
  (cdtls
  dsp-tools start-stack --no-prune)
}

dtupl(){
  (cdtls
  dsp-tools start-stack --no-prune --latest)
}

dtdwn(){
  (cdtls
  dsp-tools stop-stack)
}

dtrestrt(){
  (cdtls
  dtdwn
  dtup)
}

dtcreate(){
    (cdtls
    dsp-tools create testdata/json-project/systematic-project-4123.json)
}

dtxmlupload(){
    (cdtls
    dsp-tools xmlupload testdata/xml-data/test-data-systematic-4123.xml)
}


#####################
# CLAUDE CODE DEV
#####################

# Start Claude Code in the current directory with the dasch-claude-plugins
# loaded directly from the local feature-branch checkout, bypassing the cache.
# Use this alias instead of `claude` when testing plugin changes.
_DASCH_PLUGINS="${HOME}/Desktop/Cloned_GitHub_repos/dasch-claude-plugins"
alias cc-dev="claude \
  --plugin-dir ${_DASCH_PLUGINS}/eng \
  --plugin-dir ${_DASCH_PLUGINS}/rdu \
  --plugin-dir ${_DASCH_PLUGINS}/sbe"


#########
# GENERAL
#########

rff(){
  ruff format . && ruff check . --fix
}

gcall() {
  COMMIT_MESSAGE="${1:-Commit all changes}"
  git commit -a --no-verify -m "$COMMIT_MESSAGE"
}

gdiff() {
  git diff
}

gpush() {
  git push
}

gdiscard() {
  git checkout -- .
}

gdelb() {
    read "confirmation?Delete all local git branches except the current branch, main, and master [y/n]? "
    if [[ "$confirmation" == "y" ]]; then
        git branch | egrep -v "(^\*|main|master)" | xargs git branch -d
    fi
    }


##########
# PERSONAL
##########
pla() {
  pluck + allow "$1"
}

pls() {
  pluck export -r | grep "$1"
}
